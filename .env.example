# Indicio Cult — variáveis de ambiente
#
# Copie para `.env` e preencha. Nunca commite o `.env`.
# A aplicação lê configuração via `src/lib/env/` (zod). Foundation valida na
# inicialização; Nuvemshop valida quando uma operação solicita configuração.
# Um teste garante a sincronização das chaves e schemas (SPEC-foundation §8.4).
#
# Prefixo NEXT_PUBLIC_ = vai ao navegador. Nunca coloque segredo nele.

# --- Público (navegador e servidor) ---------------------------------------

# URL canônica do site; usada em canonical, Open Graph e sitemap.
# Local: http://localhost:3000. Produção: URL do domínio configurado no Coolify.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projeto Supabase (Dashboard → Settings → API Keys). Na ANON_KEY use a chave
# publishable (`sb_publishable_...`); a `anon` legada (JWT) também funciona.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DSN do Sentry para o navegador. Opcional: vazio desliga o Sentry no cliente.
NEXT_PUBLIC_SENTRY_DSN=

# --- Servidor (nunca vai ao navegador) --------------------------------------

# Chave secreta do Supabase (`sb_secret_...`, ou a `service_role` legada);
# ignora RLS. Só `src/lib/supabase/admin.ts` a usa.
SUPABASE_SERVICE_ROLE_KEY=

# DSN do Sentry para o servidor. Opcional: vazio desliga o Sentry no servidor.
SENTRY_DSN=

# `true` coloca a vitrine em manutenção (503 + página /manutencao); /api/health
# continua respondendo. Padrão: false.
MAINTENANCE_MODE=false

# Sha do commit em execução, exposto em /api/health. No Coolify é vinculado a
# SOURCE_COMMIT; fora do deploy assume "dev". Não precisa preencher localmente.
APP_VERSION=

# --- Nuvemshop runtime (servidor; nunca build arg ou NEXT_PUBLIC_) -----------

# Loja única: string decimal positiva, preservada sem conversão numérica.
# Obrigatório somente nas operações API Nuvemshop. Vazio não ativa integração.
NUVEMSHOP_STORE_ID=

# Access token Bearer; obrigatório somente nas operações API Nuvemshop.
# Preencha via secret manager/runtime. Não enviar ao build/CI ou navegador.
NUVEMSHOP_ACCESS_TOKEN=

# App secret current para HMAC futuro; independente do access token.
# HR-03 governa rotação futura. Vazio deve falhar ao solicitar material HMAC.
NUVEMSHOP_CLIENT_SECRET=

# Versão API interna fixa em 2025-03; não há override por variável de ambiente.

# --- Tooling local/CI (não lidas pela aplicação) -----------------------------

# Ref do projeto Supabase para `npm run db:types` e `npm run db:migrate`
# (o Supabase CLI também exige SUPABASE_ACCESS_TOKEN, via `supabase login`).
SUPABASE_PROJECT_ID=

# App ID não-secret, apenas bootstrap/OAuth tooling. Não exigido pelo runtime
# store-scoped; nunca usar NEXT_PUBLIC_NUVEMSHOP_* (inclusive chaves novas).
NUVEMSHOP_APP_ID=
