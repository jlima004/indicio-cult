# Indicio Cult — variáveis de ambiente
#
# Copie para `.env` e preencha. Nunca commite o `.env`.
# A aplicação lê tudo via `src/lib/env/` (zod) e falha na inicialização se algo
# obrigatório faltar. Um teste unitário garante que as chaves deste arquivo e as
# dos schemas estejam sincronizadas (SPEC-foundation §8.4).
#
# Prefixo NEXT_PUBLIC_ = vai ao navegador. Nunca coloque segredo nele.

# --- Público (navegador e servidor) ---------------------------------------

# URL canônica do site; usada em canonical, Open Graph e sitemap.
# Local: http://localhost:3000. Produção: https://<SITE_HOST>.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projeto Supabase (Dashboard → Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DSN do Sentry para o navegador. Opcional: vazio desliga o Sentry no cliente.
NEXT_PUBLIC_SENTRY_DSN=

# --- Servidor (nunca vai ao navegador) --------------------------------------

# Chave service role do Supabase; só `src/lib/supabase/admin.ts` a usa.
SUPABASE_SERVICE_ROLE_KEY=

# DSN do Sentry para o servidor. Opcional: vazio desliga o Sentry no servidor.
SENTRY_DSN=

# `true` coloca a vitrine em manutenção (503 + página /manutencao); /api/health
# continua respondendo. Padrão: false.
MAINTENANCE_MODE=false

# Sha do commit em execução, exposto em /api/health. Injetado pela imagem Docker;
# fora dela assume "dev". Não precisa preencher localmente.
APP_VERSION=

# --- Tooling e deploy (não lidas pela aplicação) ----------------------------

# Ref do projeto Supabase para `npm run db:types` e `npm run db:migrate`
# (o Supabase CLI também exige SUPABASE_ACCESS_TOKEN, via `supabase login`).
SUPABASE_PROJECT_ID=

# Host servido pelo Caddy no VPS (`<ip-com-hifens>.sslip.io` até haver domínio).
SITE_HOST=
